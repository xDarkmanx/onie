#!/bin/bash

#  Copyright (C) 2013 Curt Brune <curt@cumulusnetworks.com>
#  Copyright (C) 2016 Pankaj Bansal <pankajbansal3073@gmail.com>
#
#  SPDX-License-Identifier:     GPL-2.0

SERIES="$1"
SRC="$2"

if [ -z "$SERIES" -o -z "$SRC" -o ! -f "$SERIES" -o ! -d "$SRC" ]; then
    echo "Usage: $0 /path/to/series /path/to/source"
    exit 100
fi

SERIES="`realpath \"$SERIES\"`"
PATCH_ROOT=`dirname $SERIES`

cd "$SRC" || exit 1

if git rev-parse --verify refs/stacks/main >/dev/null 2>&1 || \
   git config --get branch.main.stgit.stack >/dev/null 2>&1 || \
   test -d "$(git rev-parse --git-path patches)/main" ; then
    # Already an stgit-managed source tree (patch stage re-run after
    # series/patches changed): tolerate re-init. Skip the import
    # entirely when every patch in the series is already in the
    # stack (stg import errors on duplicate patch names).
    stg init || true
    missing=0
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        p="${line%%[[:space:]]*}"
        stg series --all | awk '{print $NF}' | grep -Fxq "$p" || missing=1
    done < "$SERIES"
    if [ "$missing" -eq 0 ]; then
        exit 0
    fi
    stg import -s "$SERIES"
    exit $?
fi

git init &&
git add . > /dev/null &&
git commit -m "Unmodified $(basename $SRC) src" --allow-empty > /dev/null &&
stg init && 
stg import -s "$SERIES" &&
echo -e "%(description)s\n" > .git/patchexport.tmpl
