Subject: [PATCH] Makefile changes for ONIE

Append ONIE_CFLAGS/ONIE_LDFLAGS. Install symlink fixes from
the 3.2.1-era patch are upstream now.
diff --git a/Makefile b/Makefile
index a726773..7d2567c 100644
--- a/Makefile
+++ b/Makefile
@@ -4,6 +4,10 @@
 OPT=-O2
 CFLAGS=$(OPT) -Wall -W -Wno-parentheses -Wstrict-prototypes -Wmissing-prototypes
 
+# ONIE build environment changes
+CFLAGS  += $(ONIE_CFLAGS)
+LDFLAGS += $(ONIE_LDFLAGS)
+
 VERSION=3.15.0
 DATE=2026-04-05
 
