Subject: [PATCH] fix -Wextra warnings

- am65-cpsw-nuss: init ale_pos NULL (cpsw_dump_ale returns early on
  NULL ale_hdr, gcc cannot correlate the two)
- monitor: drop write-only argc
diff --git a/am65-cpsw-nuss.c b/am65-cpsw-nuss.c
index fbb20bf..f3b225b 100644
--- a/am65-cpsw-nuss.c
+++ b/am65-cpsw-nuss.c
@@ -461,7 +461,7 @@ int am65_cpsw_dump_regs(struct  ethtool_drvinfo *info __maybe_unused,
 			struct ethtool_regs *regs)
 {
 	struct k3_cpsw_regdump_hdr *dump_hdr, *ale_hdr = NULL;
-	u32 *reg = (u32 *)regs->data, *ale_pos;
+	u32 *reg = (u32 *)regs->data, *ale_pos = NULL;
 	u32 mod_id;
 	int i, regdump_len = info->regdump_len;
 
diff --git a/netlink/monitor.c b/netlink/monitor.c
index a16cb97..8f1abde 100644
--- a/netlink/monitor.c
+++ b/netlink/monitor.c
@@ -231,7 +231,6 @@ static int parse_monitor(struct cmd_context *ctx)
 {
 	struct nl_context *nlctx = ctx->nlctx;
 	char **argp = ctx->argp;
-	int argc = ctx->argc;
 	const char *opt = "";
 	bool opt_found;
 	unsigned int i;
@@ -239,7 +238,6 @@ static int parse_monitor(struct cmd_context *ctx)
 	if (*argp && argp[0][0] == '-') {
 		opt = *argp;
 		argp++;
-		argc--;
 	}
 	opt_found = false;
 	clear_filter(nlctx);
