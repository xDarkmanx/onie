Subject: [PATCH] time: fix -Wextra sign-compare

cur_year is a copy of int tm_year - make it int;
the (int)cur_year cast becomes redundant and is dropped.
diff --git a/libbb/time.c b/libbb/time.c
index f09ef5d..005abda 100644
--- a/libbb/time.c
+++ b/libbb/time.c
@@ -170,7 +170,7 @@ int FAST_FUNC parse_datestr(const char *date_str, struct tm *ptm)
 		 * In bbox, this format is special-cased in date applet
 		 * (IOW: this function assumes "touch -t" format).
 		 */
-		unsigned cur_year = ptm->tm_year;
+		int cur_year = ptm->tm_year;
 		int len = strchrnul(date_str, '.') - date_str;
 
 		/* MM[.SS] */
@@ -211,7 +211,7 @@ int FAST_FUNC parse_datestr(const char *date_str, struct tm *ptm)
 					&end) >= 5) {
 			/* Adjust month from 1-12 to 0-11 */
 			ptm->tm_mon -= 1;
-			if ((int)cur_year >= 50) { /* >= 1950 */
+			if (cur_year >= 50) { /* >= 1950 */
 				/* Adjust year: */
 				/* 1. Put it in the current century */
 				ptm->tm_year += (cur_year / 100) * 100;
