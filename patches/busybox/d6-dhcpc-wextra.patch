Subject: [PATCH] d6_dhcpc: fix -Wextra warnings

- bytes (int) vs sizeof()+ntohs(): compare in the int domain
- "fall right through" comments and a missing marker: canonical
  /* fall through */ (trailing words break the =3 regex)
- Advertise->Reply Rapid Commit: marker after the explanation comment
diff --git a/networking/udhcp/d6_dhcpc.c b/networking/udhcp/d6_dhcpc.c
index cdd0618..baf70ab 100644
--- a/networking/udhcp/d6_dhcpc.c
+++ b/networking/udhcp/d6_dhcpc.c
@@ -921,7 +921,7 @@ static NOINLINE int d6_recv_raw_packet(struct in6_addr *peer_ipv6, struct d6_pac
 		return -2;
 	}
 
-	if (bytes < sizeof(packet.ip6) + ntohs(packet.ip6.ip6_plen)) {
+	if (bytes < (int)sizeof(packet.ip6) + (int)ntohs(packet.ip6.ip6_plen)) {
 		/* packet is bigger than sizeof(packet), we did partial read */
 		log1s("oversized packet, ignoring");
 		return -2;
@@ -1447,7 +1447,7 @@ int udhcpc6_main(int argc UNUSED_PARAM, char **argv)
 			got_SIGUSR1:
 				log1s("entering renew state");
 				change_listen_mode(LISTEN_KERNEL);
-				/* fall right through */
+				/* fall through */
 			case RENEW_REQUESTED: /* in manual (SIGUSR1) renew */
 			case RENEWING:
 				if (packet_num == 0) {
@@ -1480,7 +1480,7 @@ int udhcpc6_main(int argc UNUSED_PARAM, char **argv)
 				/* Switch to bcast receive */
 				change_listen_mode(LISTEN_RAW);
 				packet_num = 0;
-				/* fall right through */
+				/* fall through */
 			case REBINDING:
 				/* Lease is *really* about to run out,
 				 * try to find DHCP server using broadcast */
@@ -1541,6 +1541,7 @@ int udhcpc6_main(int argc UNUSED_PARAM, char **argv)
 				/* Two SIGUSR1 received, start things over */
 				change_listen_mode(LISTEN_NONE);
 				d6_run_script_no_option("deconfig");
+			/* fall through */
 
 			default:
 			/* case RELEASED: */
@@ -1600,6 +1601,7 @@ int udhcpc6_main(int argc UNUSED_PARAM, char **argv)
 			 * server sends Reply right away.
 			 * Fall through to check for this case.
 			 */
+			/* fall through */
 		case REQUESTING:
 		case RENEWING:
 		case RENEW_REQUESTED:
