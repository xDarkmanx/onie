Subject: [PATCH] bzip2: fix signedness of loop counters and bounds

Harmonize int/unsigned types in the vendored bzip2 sort and Huffman
grouping code so every comparison is between same-signedness types:
loop counters, group bounds (gs/ge), selector counts, nPart, the
Knuth increments table and nblock in mainGtU. No casts, no pragmas;
values are non-negative by construction.
diff --git a/archival/libarchive/bz/blocksort.c b/archival/libarchive/bz/blocksort.c
index 74f9575..6386c9d 100644
--- a/archival/libarchive/bz/blocksort.c
+++ b/archival/libarchive/bz/blocksort.c
@@ -384,7 +384,7 @@ int mainGtU(EState* state,
 
 	uint8_t  *const block    = state->block;
 	uint16_t *const quadrant = state->quadrant;
-	const int32_t   nblock   = state->nblock;
+	const uint32_t  nblock   = state->nblock;
 
 /* Loop unrolling here is actually very useful
  * (generated code is much simpler),
@@ -459,7 +459,7 @@ int mainGtU(EState* state,
  * usually small, typically <= 20.
  */
 static
-const uint32_t incs[14] ALIGN4 = {
+const int32_t incs[14] ALIGN4 = {
 	1, 4, 13, 40, 121, 364, 1093, 3280,
 	9841, 29524, 88573, 265720,
 	797161, 2391484
@@ -835,13 +835,13 @@ void mainSort(EState* state)
 	{
 		/* bbox: was: int32_t h = 1; */
 		/* do h = 3 * h + 1; while (h <= 256); */
-		unsigned h = 364;
+		int32_t h = 364;
 
 		do {
 			/*h = h / 3;*/
 			h = (h * 171) >> 9; /* bbox: fast h/3 */
 			for (i = h; i <= 255; i++) {
-				unsigned vv, jh;
+				int32_t vv, jh;
 				vv = runningOrder[i]; /* uint8[] */
 				j = i;
 				while (jh = j - h, BIGFREQ(runningOrder[jh]) > BIGFREQ(vv)) {
@@ -860,7 +860,7 @@ void mainSort(EState* state)
 	 */
 
 	for (i = 0; /*i <= 255*/; i++) {
-		unsigned ss;
+		int32_t ss;
 
 		/*
 		 * Process big buckets, starting with the least full.
@@ -1030,7 +1030,7 @@ int32_t BZ2_blockSort(EState* state)
 	/* In original bzip2 1.0.4, it's a parameter, but 30
 	 * (which was the default) should work ok. */
 	enum { wfact = 30 };
-	unsigned i;
+	int32_t i;
 	int32_t origPtr = origPtr;
 
 	if (state->nblock >= 10000) {
