Subject: [PATCH] cpio: unsigned sentinel for uoff_t cpio__blocks

cpio__blocks is uoff_t (unsigned); the -1 sentinel was spelled
(off_t)-1, mixing signedness in the comparison. Use (uoff_t)-1 on
both sides — same bit pattern, same semantics.
diff --git a/archival/cpio.c b/archival/cpio.c
index 7149782..a4efb67 100644
--- a/archival/cpio.c
+++ b/archival/cpio.c
@@ -565,13 +565,13 @@ int cpio_main(int argc UNUSED_PARAM, char **argv)
 	}
 
 	/* see get_header_cpio */
-	archive_handle->cpio__blocks = (off_t)-1;
+	archive_handle->cpio__blocks = (uoff_t)-1;
 	while (get_header_cpio(archive_handle) == EXIT_SUCCESS)
 		continue;
 
 	create_links_from_list(archive_handle->link_placeholders);
 
-	if (archive_handle->cpio__blocks != (off_t)-1
+	if (archive_handle->cpio__blocks != (uoff_t)-1
 	 && !(opt & OPT_QUIET)
 	) {
 		fflush_all();
