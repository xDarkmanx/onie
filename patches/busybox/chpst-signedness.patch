Subject: [PATCH] chpst: fix -Wextra sign-compare

l < 0 is checked first, so (rlim_t)l is lossless here.
diff --git a/runit/chpst.c b/runit/chpst.c
index af77756..6073900 100644
--- a/runit/chpst.c
+++ b/runit/chpst.c
@@ -265,7 +265,7 @@ static void limit(int what, long l)
 
 	/* Never fails under Linux (except if you pass it bad arguments) */
 	getrlimit(what, &r);
-	if ((l < 0) || (l > r.rlim_max))
+	if ((l < 0) || ((rlim_t)l > r.rlim_max))
 		r.rlim_cur = r.rlim_max;
 	else
 		r.rlim_cur = l;
