Subject: [PATCH] packet: fix -Wextra sign-compare

bytes is int; offsetof yields size_t (small header size).
diff --git a/networking/udhcp/packet.c b/networking/udhcp/packet.c
index 5299781..0be8936 100644
--- a/networking/udhcp/packet.c
+++ b/networking/udhcp/packet.c
@@ -89,7 +89,7 @@ int FAST_FUNC udhcp_recv_kernel_packet(struct dhcp_packet *packet, int fd)
 		return bytes; /* returns -1 */
 	}
 
-	if (bytes < offsetof(struct dhcp_packet, options)
+	if (bytes < (int)offsetof(struct dhcp_packet, options)
 	 || packet->cookie != htonl(DHCP_MAGIC)
 	) {
 		bb_simple_info_msg("packet with bad magic, ignoring");
