Subject: [PATCH] grep: int-bound the lines_before clamp

INT_MAX / sizeof(long long) is size_t; cast the constant bound to
int for the comparison and clamped assignment.
diff --git a/findutils/grep.c b/findutils/grep.c
index 0b72812..1bdf2ac 100644
--- a/findutils/grep.c
+++ b/findutils/grep.c
@@ -745,8 +745,8 @@ int grep_main(int argc UNUSED_PARAM, char **argv)
 		lines_before = 0;
 		lines_after = 0;
 	} else if (lines_before > 0) {
-		if (lines_before > INT_MAX / sizeof(long long))
-			lines_before = INT_MAX / sizeof(long long);
+		if (lines_before > (int)(INT_MAX / sizeof(long long)))
+			lines_before = (int)(INT_MAX / sizeof(long long));
 		/* overflow in (lines_before * sizeof(x)) is prevented (above) */
 		before_buf = xzalloc(lines_before * sizeof(before_buf[0]));
 		IF_EXTRA_COMPAT(before_buf_size = xzalloc(lines_before * sizeof(before_buf_size[0]));)
