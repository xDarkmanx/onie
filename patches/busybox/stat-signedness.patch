Subject: [PATCH] stat: unsigned i in human_fstype

i iterates ARRAY_SIZE(fstype); unsigned matches.
diff --git a/coreutils/stat.c b/coreutils/stat.c
index 2c2909e..7e480fe 100644
--- a/coreutils/stat.c
+++ b/coreutils/stat.c
@@ -217,7 +217,7 @@ static const char *human_fstype(uint32_t f_type)
 		FS_TYPE_LIST
 		"UNKNOWN";
 # undef FS_TYPE
-	int i;
+	unsigned i;
 
 	for (i = 0; i < ARRAY_SIZE(fstype); ++i)
 		if (fstype[i] == f_type)
