Subject: [PATCH] mpstat: fix -Wextra sign-compare

CPU/IRQ counts are small: cast G.cpu_nr and sizeof() to int for
the int loop counters, and int irq-count params to unsigned for
the unsigned irq counters.
diff --git a/procps/mpstat.c b/procps/mpstat.c
index c78c1f0..53123b1 100644
--- a/procps/mpstat.c
+++ b/procps/mpstat.c
@@ -218,7 +218,7 @@ static void write_irqcpu_stats(struct stats_irqcpu *per_cpu_stats[],
 	}
 	bb_putchar('\n');
 
-	for (cpu = 1; cpu <= G.cpu_nr; cpu++) {
+	for (cpu = 1; cpu <= (int)G.cpu_nr; cpu++) {
 		/* Check if we want stats about this CPU */
 		if (!is_cpu_in_bitmap(cpu) && G.p_option) {
 			continue;
@@ -330,7 +330,7 @@ static void write_stats_core(int prev, int current,
 		//	G.header_done = 1;
 		//}
 
-		for (cpu = 0; cpu <= G.cpu_nr; cpu++) {
+		for (cpu = 0; cpu <= (int)G.cpu_nr; cpu++) {
 			data_t per_cpu_itv;
 
 			/* Print stats about this particular CPU? */
@@ -389,7 +389,7 @@ static void write_stats_core(int prev, int current,
 		//	G.avg_header_done = 1;
 		//}
 
-		for (cpu = 0; cpu <= G.cpu_nr; cpu++) {
