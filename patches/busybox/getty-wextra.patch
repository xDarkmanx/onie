Subject: [PATCH] getty: fix -Wextra warnings

- keep exactly "/* fall through */" as the last comment before case
  (trailing words after "through" break the =3 regex); the
  explanation goes into a separate comment above
- (bp - G.line_buf) is non-negative: cast to size_t for the
  sizeof() compare
diff --git a/loginutils/getty.c b/loginutils/getty.c
index cd6378d..719fd81 100644
--- a/loginutils/getty.c
+++ b/loginutils/getty.c
@@ -517,11 +517,12 @@ static char *get_logname(void)
 				 * return NULL (will switch speeds and return here) */
 				if (G.numspeed > 1)
 					return NULL;
-				/* fall through and ignore it */
+				/* else fall through and ignore the BREAK */
+				/* fall through */
 			default:
 				if ((unsigned char)c < ' ') {
 					/* ignore garbage characters */
-				} else if ((int)(bp - G.line_buf) < sizeof(G.line_buf) - 1) {
+				} else if ((size_t)(bp - G.line_buf) < sizeof(G.line_buf) - 1) {
 					/* echo and store the character */
 					full_write(STDOUT_FILENO, &c, 1);
 					*bp++ = c;
