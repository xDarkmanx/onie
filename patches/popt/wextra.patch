Subject: [PATCH] poptconfig: fix -Wextra errors

- calloc(nmemb, size) argument order
- cast strchr result: p is const char* but points into writable
  xstrdup buffer, write through pe is intended
diff --git a/src/poptconfig.c b/src/poptconfig.c
index bf201e2..cdc78fb 100644
--- a/src/poptconfig.c
+++ b/src/poptconfig.c
@@ -138,7 +138,7 @@ int poptReadFile(const char * fn, char ** bp, size_t * nbp, int flags)
     if ((nb = lseek(fdno, 0, SEEK_END)) == (off_t)-1
      || (uintmax_t)nb >= SIZE_MAX
      || lseek(fdno, 0, SEEK_SET) == (off_t)-1
-     || (b = calloc(sizeof(*b), (size_t)nb + 1)) == NULL
+     || (b = calloc((size_t)nb + 1, sizeof(*b))) == NULL
      || read(fdno, (char *)b, (size_t)nb) != (ssize_t)nb)
     {
 	int oerrno = errno;
@@ -405,7 +405,7 @@ int poptReadConfigFiles(poptContext con, const char * paths)
 	int xx;
 
 	/* locate start of next path element */
-	pe = strchr(p, ':');
+	pe = (char *) strchr(p, ':');
 	if (pe != NULL && *pe == ':')
 	    *pe++ = '\0';
 	else
